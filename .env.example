# Ключи задаются только на сервере (файл .env или переменные окружения).
# В клиентский код ничего из этого не попадает.

# Порт сервера
PORT=3000

# Никнейм на stats.fm, из которого берётся последний трек.
# Профиль должен существовать и быть публичным на https://stats.fm
STATSFM_USER=

# Необязательный GitHub-токен (увеличивает лимит API-запросов).
# Создать: https://github.com/settings/tokens (без прав доступа)
GITHUB_TOKEN=
